# ---- 个人数据（绝不入库）----
# server-config.json 含 115 cookie、代理等个人凭据
server-config.json
userdata.json
watch.json
media-path.txt
启动.command
docker-env.sh
# docker-compose.yml 含内网 IP，仓库只保留 example 版
docker-compose.yml
*.bak

# ---- 大体积数据目录（按 README 说明自行放置）----
# cache/ 是运行时缓存不入库，但 CI 构建需要目录存在，只保留 .gitkeep 骨架
cache/*
!cache/.gitkeep
actresses/
media-empty/

# ---- 构建辅助 / 开发产物 ----
node_modules/
_build-exclude/
shot-*.png
# CI 构建需要此文件存在（内容为 []，无个人数据）
!actresses-extra.json

# ---- 系统杂项 ----
.DS_Store
*.log
*.bak-cloud

# ---- 仓库卫生：大体积样例/种子数据 ----
# sample-cache/ 完整版 118 部 / 117MB，仅本地保留；仓库只入库一个精简子集（30 部），
# 既避免仓库增重，又保证 Dockerfile 的 `COPY sample-cache` 有内容可拷
# —— 源路径不存在时 docker 会直接构建失败（2026-10-01 云端 CI 就卡在这）。
sample-cache/*
!sample-cache/SEED_VER
!sample-cache/movies
sample-cache/movies/*
