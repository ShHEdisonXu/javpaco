# ---- 个人数据（绝不入库）----
# server-config.json 含 115 cookie、代理等个人凭据
server-config.json
userdata.json
watch.json
media-path.txt
启动.command
docker-env.sh
# docker-compose.yml 含内网 IP，仓库只保留 example 版
docker-compose.yml
*.bak

# ---- 大体积数据目录（按 README 说明自行放置）----
# cache/ 是运行时缓存不入库，但 CI 构建需要目录存在，只保留 .gitkeep 骨架
cache/*
!cache/.gitkeep
actresses/
media-empty/

# ---- 构建辅助 / 开发产物 ----
node_modules/
_build-exclude/
shot-*.png
# CI 构建需要此文件存在（内容为 []，无个人数据）
!actresses-extra.json

# ---- 系统杂项 ----
.DS_Store
*.log
*.bak-cloud

# ---- 仓库卫生：样例/种子数据 ----
# sample-cache/ 完整版 118 部 / 117MB **全部入库**（2026-10-01 用户要求「118 部全放回去」）：
# 曾用白名单只留 30 部，现恢复完整包 —— Dockerfile 有 `COPY sample-cache`，
# 源路径不存在时 docker 会直接构建失败（2026-10-01 云端 CI 就卡在这），
# 内容为空或裁剪都会让「没挂媒体时也能看到内容」的演示体验变差。
# 注意：单文件最大 ~1.2MB，远低于 GitHub 100MB 硬限；全仓库约 +117MB。
# 女优名册 16MB；不入库，运行时缺失时由 server.js 优雅降级（见 ROSTER 缺失守卫）
actresses.json
